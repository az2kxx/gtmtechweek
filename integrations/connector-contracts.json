        "ad account and currency",
        "landing page and capability intake",
        "approved media cap",
        "draft-only creation capability",
        "verified lead feedback/export",
        "approved claims and campaign launch"
      ],
      "input_fields": [
        "brief_id",
        "sector",
        "target_regions",
        "missing_roles",
        "supplier_profile",
        "public_evidence_urls",
        "offer",
        "cta",
        "landing_page_url",
        "currency",
