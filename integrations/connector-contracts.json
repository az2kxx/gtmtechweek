{
  "version": 1,
  "mode": "SCAFFOLD_ONLY",
  "shared": {
    "system_of_record": "Repository for public PoC; Attio remains optional private mirror",
    "project": "gtmtechweek",
    "weekly_schedule": "existing Monday automation",
    "clay": {
      "unit": "DATA_CREDITS",
      "max_per_logical_execution": 299,
      "monthly_cap": null,
      "cost_unknown": "BLOCK_BILLABLE",
      "run_id_rule": "All branches/retries/resumes share original run_id"
    },
    "identity_keys": [
      "run_id",
      "tender_id",
      "official_reference",
      "lot_id",
      "company_id",
      "attio_person_id",
      "clay_person_id",
      "delivery_option_id",
      "pair_id",
      "campaign_id",
      "content_id"
    ],
    "event": {
      "required": [
        "provider",
        "workspace_id",
        "event_id",
        "occurred_at",
        "received_at",
        "type",
        "external_object_id"
      ],
      "optional": [
        "attio_person_id",
        "company_domain",
        "normalized_linkedin",
        "tender_id",
        "payload",
        "utm_source",
        "utm_medium",
        "utm_campaign",
        "utm_content"
      ],
      "deduplication": "provider + workspace_id + event_id",
      "ordering": "Keep source and receipt timestamps; append history, reject stale state transitions; suppression is sticky until explicit consent review"
    }
  },
  "connectors": {
